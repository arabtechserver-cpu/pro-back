generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventName String
  sessionId String?
  path      String?
  metadata  String?
  createdAt DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(uuid())
  titleEn   String
  titleAr   String
  excerptEn String
  excerptAr String
  contentEn String
  contentAr String
  imageUrl  String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model DhruCategory {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime      @default(now())
  dhruServices DhruService[]
}

model DhruService {
  id             String        @id @default(uuid())
  dhruId         String        @unique
  name           String
  originalName   String
  groupName      String
  credit         Float
  time           String
  info           String?
  isActive       Boolean       @default(true)
  margin         Float         @default(0)
  categoryId     String?
  providerId     String?
  apiServiceType String?       @map("api_service_type")
  requiresCustom String?
  originalPrice  Float?
  supportsQty    Boolean       @default(false)
  minQty         Int           @default(1)
  maxQty         Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  dhruCategory   DhruCategory? @relation(fields: [categoryId], references: [id])
  apiProvider    ApiProvider?  @relation(fields: [providerId], references: [id], onDelete: SetNull)
}

model ApiProvider {
  id            String        @id @default(uuid())
  name          String
  apiUrl        String
  username      String?
  apiKey        String
  type          String        @default("dhru")
  isActive      Boolean       @default(true)
  balance       Float         @default(0.0)
  currency      String        @default("USD")
  servicesCount Int           @default(0)
  mappingRules  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  services      DhruService[]
}

model StoredImage {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String   @default("image/jpeg")
  data      String
  size      Int      @default(0)
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model NewsletterBroadcast {
  id         String   @id @default(uuid())
  subject    String
  title      String
  message    String
  category   String?
  actionUrl  String?
  actionText String?
  sentCount  Int      @default(0)
  createdAt  DateTime @default(now())
}

model Order {
  id          String   @id @default(uuid())
  userId      String?
  serviceName String
  serviceId   String
  targetInput String
  quantity    Int      @default(1)
  price       Float
  status      String   @default("pending")
  apiOrderId  String?
  reply       String?
  notes       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  source           String   @default("web")
  apiClientOrderId String?
}

model Transaction {
  id           String   @id @default(uuid())
  userId       String
  type         String
  amount       Float
  method       String
  status       String   @default("pending")
  refNo        String
  receiptImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([status, createdAt])
}

model User {
  id               String          @id @default(uuid())
  fullName         String
  email            String          @unique
  username         String          @unique
  password         String
  phone            String?
  country          String          @default("EG")
  role             String          @default("user")
  status           String          @default("active")
  balance          Float           @default(0.0)
  membershipTierId String?
  customDiscount   Float           @default(0.0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  orders           Order[]
  transactions     Transaction[]
  membershipTier   MembershipTier? @relation(fields: [membershipTierId], references: [id])
  apiEnabled       Boolean         @default(false)
  apiKey           String?         @unique
  apiSiteName      String?
  apiSiteUrl       String?
  apiMargin        Float           @default(0.0)
}

model MembershipTier {
  id                 String   @id @default(uuid())
  name               String
  nameAr             String?
  minDeposit         Float    @default(0.0)
  discountPercentage Float    @default(0.0)
  badgeColor         String?  @default("#2dd4bf")
  description        String?
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  users              User[]
}

model VideoSeries {
  id                     String          @id @default(uuid())
  titleEn                String
  titleAr                String
  descriptionEn          String?
  descriptionAr          String?
  thumbnail              String?
  isSubscriptionRequired Boolean         @default(false)
  price                  Float?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt
  videoTutorials         VideoTutorial[]
}

model VideoTutorial {
  id            String       @id @default(uuid())
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  videoUrl      String
  thumbnail     String?
  category      String?
  seriesId      String?
  orderIndex    Int          @default(0)
  isFreePreview Boolean      @default(true)
  createdAt     DateTime     @default(now())
  videoSeries   VideoSeries? @relation(fields: [seriesId], references: [id])
}

model WalletTransaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  type      String
  status    String   @default("completed")
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

